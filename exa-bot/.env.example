# ── EXO Bot — .env (copie depuis cet exemple, ne commite JAMAIS le vrai .env) ──

# Telegram (BotFather + @userinfobot pour le chat_id)
TELEGRAM_BOT_TOKEN=123456:ABC-ton-token
TELEGRAM_CHAT_ID=123456789

# ── Airtable (CRM) ────────────────────────────────────────────────────────────
# Token : https://airtable.com/create/tokens
# Scopes requis : data.records:read, data.records:write,
#                 schema.bases:read, schema.bases:write (pour /setup)
AIRTABLE_TOKEN=patXXXXXXXXXXXXXX.xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
AIRTABLE_BASE_ID=appXXXXXXXXXXXXXX

# ── Zeruh (vérification d'email) ──────────────────────────────────────────────
# https://zeruh.com/api-docs
ZERUH_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Email (campagnes) — SMTP + IMAP ───────────────────────────────────────────
# OVH : SMTP SSL port 465, IMAP SSL 993. ⚠️ utilise un mot de passe d'application.
SMTP_HOST=ssl0.ovh.net
SMTP_PORT=465
SMTP_USER=toi@domaine.com
SMTP_PASS=mot-de-passe-application
SMTP_FROM=Ton Nom <toi@domaine.com>
IMAP_HOST=ssl0.ovh.net
IMAP_PORT=993
MAIL_DRY_RUN=true          # true = ne PAS envoyer (brouillon) ; false = envoi réel
MAIL_QUOTA_JOUR=50         # plafond d'envois par jour

# ── Clés fournies PAR L'UTILISATEUR dans le chat (pas ici) ────────────────────
# Exa    : /setkey TA_CLE     (https://dashboard.exa.ai/api-keys)
# Serper : /setserper TA_CLE  (https://serper.dev/api-key)

# ── Chemins (en Docker, pointés vers le volume ./data ; voir docker-compose) ──
# KEYS_PATH=keys.json
# STATS_PATH=stats.json
